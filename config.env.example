# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=ap-northeast-1

# S3 Bucket Configuration
# Example: s3://duckdb-metabase-data-junichi/raw/log-2025-10-17.jsonl.gz
# Output: s3://duckdb-metabase-data-junichi/processed/log-2025-10-17.parquet
S3_INPUT_BUCKET=duckdb-metabase-data-junichi
S3_OUTPUT_BUCKET=duckdb-metabase-data-junichi

# Optional: S3 path prefixes (default: raw/ and processed/)
# S3_INPUT_PREFIX=raw/
# S3_OUTPUT_PREFIX=processed/

# Optional: DuckDB Configuration
# DUCKDB_MEMORY_LIMIT=2GB
# DUCKDB_THREADS=4
